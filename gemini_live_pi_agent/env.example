# ---- 上游凭据（二选一）----
# Gemini（Google AI Studio）
GOOGLE_API_KEY=
# Qwen（阿里云百炼 · workspace 维度端点）
DASHSCOPE_API_KEY=
QWEN_WORKSPACE=

# ---- 可选 ----
HTTPS_PROXY=http://127.0.0.1:1081
RELAY_ENV_FILE=                 # 凭据文件路径（默认 ~/.config/gemini-live-relay/.env）
PI_CWD=                         # pi 的工作目录（默认本项目）
PI_MODEL=                       # 例如 deepseek/deepseek-flash
PI_RPC_ARGS=--approve
PI_BRIDGE_MODE=rpc              # rpc | stub
RELAY_TERMINAL_LOG=1            # 网页日志同时打到终端
